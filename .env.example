# Server
PORT=3000
BASE_URL=http://localhost:3000

# Image storage
UPLOAD_DIR=./uploads
IMAGE_TTL_HOURS=72
MAX_VIEWS=10

# SMS provider: textbelt | twilio | console
SMS_PROVIDER=console

# TextBelt (free tier: 1 SMS/day for US numbers)
# https://textbelt.com
TEXTBELT_KEY=textbelt

# Twilio (optional — free trial credits available)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Rate limiting
MAX_SENDS_PER_HOUR=5
